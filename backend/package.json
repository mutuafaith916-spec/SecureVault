{
  "name": "securevault-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "tsx --test tests/health.test.ts tests/authCookies.test.ts tests/environment.test.ts tests/fileEncryption.test.ts tests/fileStorage.test.ts tests/totp.test.ts tests/auditHash.test.ts tests/databaseBackupCrypto.test.ts tests/uploadValidation.test.ts tests/malwareScanner.test.ts",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/config/database.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/config/database.ts",
    "migration:show": "tsx ./node_modules/typeorm/cli.js migration:show -d src/config/database.ts",
    "backup:database": "tsx scripts/databaseBackup.ts",
    "restore:database": "tsx scripts/databaseRestore.ts",
    "purge:expired-files": "tsx scripts/purgeExpiredFiles.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
