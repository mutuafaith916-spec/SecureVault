NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
STORAGE_PROVIDER=local
# For Cloudflare R2, use https://<account-id>.r2.cloudflarestorage.com and region auto.
CLOUD_STORAGE_ENDPOINT=
CLOUD_STORAGE_REGION=auto
CLOUD_STORAGE_BUCKET=
CLOUD_BACKUP_BUCKET=
CLOUD_STORAGE_ACCESS_KEY_ID=
CLOUD_STORAGE_SECRET_ACCESS_KEY=
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Supply from a secret manager in production; back up separately from file backups.
ENCRYPTION_MASTER_KEY=
# Configure every SMTP value to enable password reset email delivery.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Required in production; comma-separated recipients for suspicious security events.
SECURITY_ALERT_EMAILS=
# Production requires ClamAV; install its signatures and keep them updated.
MALWARE_SCANNER_ENABLED=false
MALWARE_SCANNER_COMMAND=clamscan
# Set this when ClamAV signatures are stored outside the scanner's default path.
MALWARE_SCANNER_DATABASE=
# Separate S3-compatible bucket and credentials for encrypted PostgreSQL backups.
DATABASE_BACKUP_ENDPOINT=
DATABASE_BACKUP_REGION=auto
DATABASE_BACKUP_BUCKET=
DATABASE_BACKUP_ACCESS_KEY_ID=
DATABASE_BACKUP_SECRET_ACCESS_KEY=
# Keep this independent from ENCRYPTION_MASTER_KEY and back it up separately.
DATABASE_BACKUP_ENCRYPTION_KEY=
# Local staging/retained encrypted copies; use a separate volume where possible.
DATABASE_BACKUP_DIRECTORY=
DATABASE_BACKUP_RETENTION_DAYS=35
