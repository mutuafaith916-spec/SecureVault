# Dependencies and build output
**/node_modules/
**/dist/
**/coverage/

# Environment files and secrets
**/.env
**/.env.*
!**/.env.example

# Logs and temporary files
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/pnpm-debug.log*
**/*.tmp
**/*.temp

# Encrypted user data must never be committed
backend/storage/encrypted/*
!backend/storage/encrypted/.gitkeep

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
